# Development only. Blank integration credentials are intentional.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://povod:povod-local-only@localhost:5432/povod
REDIS_URL=redis://localhost:6379/0
TELEGRAM_TOKEN=
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_TOKEN=
TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
# T-Bank signs notifications with the body Token only; no separate webhook secret.
TICKET_QR_SECRET=
PERSONAL_CONSENT_TEXT=
PERSONAL_CONSENT_VERSION=
MARKETING_CONSENT_TEXT=
MARKETING_CONSENT_VERSION=
RESERVATION_TTL_SECONDS=600
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
# Where uploaded event posters are stored; the file server serves them at /media/.
# MEDIA_ROOT=media
# Broadcast buttons: the Mini App link (https://t.me/<bot>/<app>) and the public address
# that serves /r/<code> click redirects. Without them a broadcast with buttons won't start.
MINIAPP_LINK=
PUBLIC_BASE_URL=
CAMPAIGN_RATE_LIMIT_PER_SECOND=25
# Optional: disposable PostgreSQL for integration tests instead of local SQLite.
# TEST_DATABASE_URL=postgresql+asyncpg://povod:povod-local-only@localhost:5432/povod_test
