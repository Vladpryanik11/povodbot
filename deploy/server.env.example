# Шаблон серверного .env. Скопируйте в /opt/povod/.env НА СЕРВЕРЕ и заполните.
# Файл .env не коммитится и не пересылается в чат. Права: chmod 600 .env
#
# Пока T-Bank не подключён, ENVIRONMENT=staging: защита как у production,
# но платёжные ключи и юридические тексты не обязательны.
# Для запуска с деньгами сменить на production и заполнить блоки ниже.
ENVIRONMENT=staging

# Адрес Mini App и API, без https:// (на него указывает A-запись домена).
DOMAIN=

# Пароль внутренней БД (придумайте длинный, только буквы и цифры).
POSTGRES_PASSWORD=

# Токен бота от @BotFather. Обязателен.
TELEGRAM_TOKEN=

# Адрес Mini App (https://<DOMAIN>). Если задан, в меню бота появляется кнопка «Открыть Повод».
MINIAPP_URL=
SUPPORT_CONTACT=

# Ключ подписи QR-билетов: openssl rand -hex 32. Обязателен. Не менять после выдачи билетов.
TICKET_QR_SECRET=

LOG_LEVEL=INFO
RESERVATION_TTL_SECONDS=600

# --- Только для production (нужны после подключения T-Bank) ---
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_WEBHOOK_SECRET=
# PERSONAL_CONSENT_TEXT=
# PERSONAL_CONSENT_VERSION=
# MARKETING_CONSENT_TEXT=
# MARKETING_CONSENT_VERSION=
