# HTTPS (Let's Encrypt) Caddy выпускает сам для домена из DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	# Служебное наружу не отдаём: документация API и метрики.
	@internal path /docs /docs/* /redoc /redoc/* /openapi.json /metrics /ready
	handle @internal {
		respond 404
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle /api/* {
		# FastAPI читает multipart до авторизации, поэтому режем тело здесь.
		request_body {
			max_size 16MB
		}
		reverse_proxy api:8000
	}

	# Афиши: имя файла = хэш содержимого, поэтому кэш вечный.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Mini App: собранная статика, любой путь без файла отдаёт index.html.
	handle {
		root * /srv/webapp
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell path /index.html /
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
